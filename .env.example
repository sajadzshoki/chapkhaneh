# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. `.env` is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Drizzle ORM and the Nitro server.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mobin_bartar"

# Public base URL, used for canonical/OG tags and i18n.
NUXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret used to sign the admin session cookie. MUST be at least 32 characters.
# Generate one with: openssl rand -base64 32
# Rotating this value invalidates all existing admin sessions.
NUXT_SESSION_PASSWORD="change-me-to-a-random-32-character-secret"

# Credentials for the single admin account created by `npm run db:seed`.
# Used only at seed time; the password is stored as a scrypt hash.
ADMIN_EMAIL="admin@mobinbartar.ir"
ADMIN_PASSWORD="change-me-before-seeding"

# --- Quote request attachments -------------------------------------------
# Maximum accepted upload size in bytes. Single source of truth for the server;
# `app/composables/useQuoteUpload.ts` mirrors it for client-side pre-checks.
# Default: 15728640 (15 MB).
MAX_QUOTE_FILE_SIZE="15728640"

# Directory where attachments are written. Relative paths resolve from the
# project root. MUST stay outside `public/` so files are never served directly;
# admins download them through the authenticated API route.
QUOTE_UPLOAD_DIR="storage/uploads/quote-requests"
